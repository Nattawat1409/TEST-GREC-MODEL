diff --git a/projects/UNINEXT/uninext/prediction_dumper.py b/projects/UNINEXT/uninext/prediction_dumper.py
new file mode 100644
index 0000000..8a74473
--- /dev/null
+++ b/projects/UNINEXT/uninext/prediction_dumper.py
@@ -0,0 +1,35 @@
+"""Saves every predicted box + score per expression (original image pixels) for TEST-GREC-MODEL/scripts/evaluate.py."""
+import itertools
+import json
+import os
+
+import detectron2.utils.comm as comm
+from detectron2.evaluation import DatasetEvaluator
+
+
+class PredictionDumper(DatasetEvaluator):
+    def __init__(self, out_file):
+        self.out_file = out_file
+
+    def reset(self):
+        self.predictions = {}
+
+    def process(self, inputs, outputs):
+        for inp, out in zip(inputs, outputs):
+            inst = out["instances"].to("cpu")
+            self.predictions[str(inp["image_id"])] = {
+                "boxes": inst.pred_boxes.tensor.tolist(),
+                "scores": inst.scores.tolist(),
+            }
+
+    def evaluate(self):
+        comm.synchronize()
+        gathered = comm.gather(self.predictions, dst=0)
+        if not comm.is_main_process():
+            return {}
+        predictions = dict(itertools.chain.from_iterable(p.items() for p in gathered))
+        os.makedirs(os.path.dirname(os.path.abspath(self.out_file)), exist_ok=True)
+        with open(self.out_file, "w") as f:
+            json.dump(predictions, f)
+        print(f"saved {len(predictions)} predictions to {self.out_file}")
+        return {}
